{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "출퇴근 관리 프로그램",
  "version": "2.0.0",
  "identifier": "com.screenmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:agent",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "출퇴근 관리 프로그램", "width": 900, "height": 650, "decorations": false, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [],
    "externalBin": ["binaries/screen-monitor-agent"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3NDg2RjEwQ0NCMDgwODMKUldTRGdMRE1FRzlJZDZZWVVkZmw5bjVhSkF5OGNkUHh1YTFnWmh3SmEvUXRKZDZPNUR4Z1RSUncK",
      "endpoints": ["https://api-production-18d6.up.railway.app/api/desktop-updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
